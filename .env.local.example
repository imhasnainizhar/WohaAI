###############################################
# 🏠 Local Development Environment Variables
# This file extends .env with local-specific overrides
# Use this for local development on your machine
###############################################

# ============================================
# Local Config
# ============================================
# These values override .env for local development

# ============================================
# Ports
# ============================================

## 🚨 WARNING: These Ports Must be Similar to .env file ports 🚨
FRONTEND_APP_PORT=3000
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
AUTH_MAILER_SERVICE_PORT=8003
WOAH_NGINX_PROXY_PORT=8000

# ============================================
# Client Origin (Docker)
# ============================================
CLIENT_ORIGIN=http://localhost:${FRONTEND_APP_PORT}
COOKIE_DOMAIN=localhost

# ============================================
# Frontend URLs (Local)
# ============================================
APP_PUBLIC_GATEWAY_BASE_URI_01=http://localhost:${WOAH_NGINX_PROXY_PORT}
NEXT_PUBLIC_BASE_URI=http://localhost:${FRONTEND_APP_PORT}
NEXT_PUBLIC_AUTH_API_URI=http://localhost:${AUTH_SERVICE_PORT}/api/auth
NEXT_PUBLIC_AUTH_MAILER_API_URI=http://localhost:${AUTH_MAILER_SERVICE_PORT}/api/auth-mailer
NEXT_PUBLIC_USER_API_URI=http://localhost:${USER_SERVICE_PORT}/api/user

# ============================================
# Kafka (Local)  
# ============================================

# Warning: Setup kafka on Local Machine before running locally!
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=localhost:9092
KAFKA_CLUSTERS_0_ZOOKEEPER=localhost:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

#=============================================
# QDRANT Vector Store Config
#=============================================
AGENT_MEMORY_STORE_PORT=6060
AGENT_MEMORY_STORE_URI=http://agent_memory_store:${AGENT_MEMORY_STORE_PORT}/