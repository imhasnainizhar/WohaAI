    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/cli": "^4.3.0",
    "@types/dotenv": "^8.2.3",
    "bcryptjs": "^3.0.3",
    "boxicons": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pnpm": "^11.3.0",
    "react": "^19.2.6",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.6.0",
    "redis": "^5.12.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "uninstall": "^0.0.0",
