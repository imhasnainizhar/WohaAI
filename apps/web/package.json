{
  "name": "WohaAI",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel tailwind:dev next:dev",
    "build": "npm-run-all tailwind:build next:build",
    "next:dev": "next dev --turbopack",
    "next:build": "next build",
    "tailwind:dev": "npx tailwindcss -i ./src/styles/main.global.css -o ./src/styles/dist/main.global.css --watch --poll",
    "tailwind:build": "npx tailwindcss -i ./src/styles/main.global.css -o ./src/styles/dist/main.global.css --minify",
    "start": "next start"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@lexical/react": "^0.45.0",
    "@packages/contracts": "workspace:*",
    "@packages/env-ts": "workspace:*",
    "@packages/db": "workspace:*",
    "@packages/errors": "workspace:*",
    "@packages/http": "workspace:*",
    "@packages/models": "workspace:*",
    "@packages/observability": "workspace:*",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/dotenv": "^8.2.3",
    "bcryptjs": "^3.0.3",
    "boxicons": "^2.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lexical": "^0.45.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.76.1",
    "react-icons": "^5.6.0",
    "redis": "^5.12.1",
