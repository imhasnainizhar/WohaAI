{
  "name": "WohaAI",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel tailwind:dev next:dev",
    "build": "npm-run-all tailwind:build next:build",
    "next:dev": "next dev --turbopack",
    "next:build": "next build",
    "tailwind:dev": "npx tailwindcss -i ./dist/styles/main/main.global.css -o ./dist/styles/dist/main.global.css --watch --poll",
    "tailwind:build": "npx tailwindcss -i ./dist/styles/main/main.global.css -o ./dist/styles/dist/main.global.css --minify",
    "start": "next start"
  },
  "prisma": {
    "schema": "./dist/prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-label": "^2.1.8",
