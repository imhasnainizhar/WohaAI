generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"        //Replacing these credentials by .env.local variables for security
  
  url      = "postgresql://postgres:odey1212@localhost:5432/userDB"  //Replacing these credentials by .env.local variables for security
}

model User {
  userID        String   @id @default(uuid())
  first_name    String
  last_name     String
  phone_number  String?
  email         String   @unique
  passwordHashed  String
  registered_at DateTime @default(now())
  created_at    DateTime @default(now())

  cards     Card[]
  addresses CustomerAddress[]
  orders    Order[]
}

model Card {
  card_id String @id @default(uuid())
  userID  String
  user    User   @relation(fields: [userID], references: [userID])
}

model CustomerAddress {
  id            String  @id @default(uuid())
  userID        String
  address_line1 String
  city          String
  postal_code   String
  phone_number  String?
  user          User    @relation(fields: [userID], references: [userID])
}

model Product {
  product_id        String   @default(uuid()) @unique
  product_name      String
  regular_price     Float
  discount_price    Float?
  quantity          Int
  short_description String?
  published         Boolean  @default(false)
  created_at        DateTime @default(now())

  categories ProductCategory[]
  tags       ProductTag[]
  OrderItem  OrderItem[]
}

model Category {
  id            Int               @id @default(autoincrement())
  category_name String
  active        Boolean
  products      ProductCategory[]
}

model ProductCategory {
  product     Product  @relation(fields: [product_id], references: [product_id])
  product_id  String
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int

  @@id([product_id, category_id])
}

model ProductTag {
  tag        Tag     @relation(fields: [tag_id], references: [id])
  tag_id     Int
  product    Product @relation(fields: [product_id], references: [product_id])
  product_id String

  @@id([tag_id, product_id])
}

model Tag {
  id       Int          @id @default(autoincrement())
  tag_name String
  products ProductTag[]
}

model Order {
  id                      String    @id @default(uuid())
  userID                  String
  coupon_id               Int?
  order_status_id         Int?
  created_at              DateTime  @default(now())
  order_delivered_date    DateTime?
  order_delivered_carrier String?

  user        User         @relation(fields: [userID], references: [userID])
  coupon      Coupon?      @relation(fields: [coupon_id], references: [id])
  status      OrderStatus? @relation(fields: [order_status_id], references: [id])
  order_items OrderItem[]
}

model OrderItem {
  id         String @id @default(uuid())
  order_id   String
  product_id String
  price      Float
  quantity   Int

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [product_id])
}

model OrderStatus {
  id          Int     @id @default(autoincrement())
  status_name String
  orders      Order[]
}

model Coupon {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  discount_value    Float
  max_usage         Int
  usage_count       Int      @default(0)
  coupon_start_date DateTime
  coupon_end_date   DateTime
  orders            Order[]
}