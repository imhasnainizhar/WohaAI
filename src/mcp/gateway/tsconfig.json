{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowSyntheticDefaultImports": true,
        /* Project Structure */
        "rootDir": "main",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@config/*": [
                "./main/config/*"
            ],
            "@utils/*": [
                "./main/utils/*"
            ],
            "@domain/*": [
                "./main/domain/*"
            ],
            "@tools/*": [
                "./main/tools/*"
            ],
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "main/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}