{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        /* Project Structure */
        "rootDir": "./src",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@app": [
                "./src/app"
            ],
            "@config/*": [
                "./src/config/*"
            ],
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@schemas/*": [
                "./src/schemas/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@custom_types/*": [
                "./src/custom_types/*"
            ],
            "@internals/*": [
                "./src/internals/*"
            ],
            "@graph/*": [
                "./src/graph/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}