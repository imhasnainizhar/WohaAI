{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        /* Project Structure */
        "rootDir": "./src",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,    
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@config/*": [
                "./src/config/*"
            ],
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@internals/*": [
                "./src/internals/*"
            ],
            "@tools/*": [
                "./src/tools/*"
            ],
            "@llm_models/*": [
                "./src/llm_models/*"
            ],
            "@memory/*": [
                "./src/memory/*"
            ],
            "@workflows/*": [
                "./src/workflows/*"
            ],
            "@graph/*": [
                "./src/graph/*"
            ],          
            "@server/*": [
                "./src/server/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts"
, "src/internals/memory/qdrant_client.mts"    ],
    "exclude": ["node_modules", "dist", "build", ".cache"]
}