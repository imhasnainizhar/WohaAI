{
  "name": "woahai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel tailwind:dev next:dev",
    "build": "npm-run-all tailwind:build next:build",
    "next:dev": "next dev --turbopack",
    "next:build": "next build",
    "tailwind:dev": "npx tailwindcss -i ./src/styles/theme/main.global.css -o ./src/styles/dist/main.global.css --watch --poll",
    "tailwind:build": "npx tailwindcss -i ./src/styles/theme/main.global.css -o ./src/styles/dist/main.global.css --minify",
    "start": "next start"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.11.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "@tailwindcss/cli": "^4.1.11",
    "@types/dotenv": "^6.1.1",
    "bcryptjs": "^3.0.2",
    "boxicons": "^2.1.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "framer-motion": "^12.23.26",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.0.6",
    "nodemailer": "^7.0.9",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "pnpm": "^10.18.2",
    "react": "^18.2.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.65.0",
    "react-icons": "^5.5.0",
    "redis": "^5.5.6",
    "tailwindcss": "^4.1.11",
    "uninstall": "^0.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@parcel/watcher": "^2.5.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.19.20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.2",
    "@types/react-google-recaptcha": "^2.1.9",
    "npm-run-all": "^4.1.5",
    "prisma": "^6.11.0",
    "typescript": "^5.9.3"
  }
}
