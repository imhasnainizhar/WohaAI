{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        /* Project Structure */
        "rootDir": ".",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": [
            "node",
            "jest"
        ],
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@app": [
                "./main/app"
            ],
            "@config/*": [
                "./main/config/*"
            ],
            "@routes/*": [
                "./main/routes/*"
            ],
            "@middleware/*": [
                "./main/middleware/*"
            ],
            "@schemas/*": [
                "./main/schemas/*"
            ],
            "@services/*": [
                "./main/services/*"
            ],
            "@controllers/*": [
                "./main/controllers/*"
            ],
            "@utils/*": [
                "./main/utils/*"
            ],
            "@domain/*": [
                "./main/domain/*"
            ],
            "@errors/*": [
                "./main/errors/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "main/**/*.ts",
        "tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}