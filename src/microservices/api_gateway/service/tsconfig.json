{
    "compilerOptions": {
      "target": "ES6",
      "module": "NodeNext",
      "moduleResolution": "nodenext",
      "outDir": "dist",
      "rootDir": "src",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "types": ["node"]  
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}