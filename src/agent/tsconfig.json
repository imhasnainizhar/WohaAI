{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        /* Project Structure */
        "rootDir": "main",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "@config/*": [
                "./main/config/*"
            ],
            "@middleware/*": [
                "./main/middleware/*"
            ],
            "@utils/*": [
                "./main/utils/*"
            ],
            "@domain/*": [
                "./main/domain/*"
            ],
            "@tools/*": [
                "./main/tools/*"
            ],
            "@llm/*": [
                "./main/llm/*"
            ],
            "@db/*": [
                "./main/db/*"
            ],
            "@workflows/*": [
                "./main/workflows/*"
            ],
            "@graph/*": [
                "./main/graph/*"
            ],
            "@server/*": [
                "./main/server/*"
            ],
            "@generated/*": [
                "./main/generated/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "main/**/*.js",
        "main/**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        ".cache"
    ]
}