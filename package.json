{
  "name": "woahai_repo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "packages:dev": "pnpm -r run package:dev",
    "packages:build": "pnpm -r run package:build",
    "typecheck": "turbo run typecheck",
    "docker:apps": "docker compose --env-file .env -f ./infra/compose/compose.apps.yml --profile apps up",
    "docker:repo": "docker compose --env-file .env -f ./infra/compose/compose.repo.yml --profile repo up",
    "docker:services": "docker compose --env-file .env -f ./infra/compose/compose.services.yml --profile services up",
    "docker:agentic": "docker compose --env-file .env -f ./infra/compose/compose.agentic.yml --profile agentic up",
    "docker:debug": "docker compose --env-file .env -f ./infra/compose/compose.debug.yml --profile debug up",
    "docker:all": "pnpm run docker:apps && pnpm run docker:repo && pnpm run docker:services && pnpm run docker:agentic && pnpm run docker:debug"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "prisma": "7.8.0"
  }
}