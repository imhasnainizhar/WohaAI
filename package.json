{
  "name": "woahai_repo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",

    "docker:apps": "docker compose --profile apps up",
    "docker:backend": "docker compose --profile services --profile repo --profile queue up",
    "docker:ai": "docker compose --profile agentic up",
    "docker:all": "docker compose --profile '*' up"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "prisma": "7.8.0"
  }
}
