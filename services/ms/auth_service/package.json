{
  "name": "auth_service",
  "version": "1.0.0",
  "description": "Microservice handling all auth logic of App",
  "main": "src/server.ts",
  "directories": {
    "src": "src",
    "test": "tests"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b -w ../../../packages/shared ./ && tsc-alias -p .",
    "start": "nodemon dist/server.js",
    "prepare": "npm run prisma:generate",
    "postinstall": "",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "WoahAI"
  },
  "keywords": [
    "AI",
    "Auth"
  ],
  "author": "Hasnain Izhar",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "module-alias": "^2.2.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "process": "^0.11.10",
    "redis": "^5.8.3",
    "ua-parser-js": "^2.0.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/argon2": "^0.14.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemon": "^1.19.6",
    "@types/redis": "^4.0.10",
    "@types/ua-parser-js": "^0.7.39",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "7.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
