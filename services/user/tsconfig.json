{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",    
        "module": "ESNext",
        "moduleResolution": "Bundler",
              /* Project Structure */
        "rootDir": ".",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}