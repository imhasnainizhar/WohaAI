{
  "name": "user-service",
  "version": "1.0.0",
  "description": "Service for user related tasks such as updating user data or fetching it",
  "main": "src/server.ts",
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --outdir=dist --format=cjs --sourcemap",
    "start": "node dist/server.js",
    "test": "vitest run",
    "clean:dist": "rimraf dist"
  },
  "repository": {
    "type": "git",
    "url": "WohaAI"
  },
  "keywords": [
    "AI",
    "User"
  ],
  "author": "Hasnain Izhar",
  "license": "MIT",
  "dependencies": {
    "@packages/config": "workspace:*",
    "@packages/contracts": "workspace:*",
    "@packages/errors": "workspace:*",
    "@packages/jwt": "workspace:*",
    "@packages/http": "workspace:*",
    "@packages/observability": "workspace:*",
    "@packages/redis": "workspace:*",
    "@packages/prisma-users": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "process": "^0.11.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/argon2": "^0.15.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
