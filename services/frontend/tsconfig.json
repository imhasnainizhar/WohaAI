{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@lib/*": [
        "./src/lib/*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@internals/*": [
        "./src/internals/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@packages/shared/*": [
        "../../packages/shared/dist/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "references": [
    {
      "path": "../../packages/shared/"
    }
  ],
  "typeRoots": [
    "./node_modules/@types",
    "../../packages/types"
  ],
  "include": [
    "src/**/*",

    "next-env.d.ts",
    "../../packages/types/**/*.d.ts",
    "../../packages/shared/**/*",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/prisma/schema.prisma",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
  ]
}