generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Ignore this error, everything is working, this is just prisma bug I think.
datasource db {
  provider = "postgresql"
}

model ThreadMessage {
  id             String   @id @default(uuid())
  conversationId String
  turnId         Int      @default(autoincrement())

  role           String
  content        String

  toolName       String?  @map("tool_name")
  toolArgs       Json?    @map("tool_args")

  model          String?
  tokenPrompt    Int?     @map("token_prompt")
  tokenCompletion Int?    @map("token_completion")

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([conversationId, turnId])
}
