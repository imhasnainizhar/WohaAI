{
  "name": "mcp_gateway",
  "version": "1.0.0",
  "description": "This MCP Gateway Server is responsible for registering all MCP Tools for LLM Runtime",
  "keywords": [
    "AI",
    "MCP",
    "WebSearch",
    "Gateway"
  ],
  "repository": {
    "type": "git",
    "url": "WohaAI"
  },
  "type": "module",
  "license": "MIT",
  "author": "Hasnain Izhar",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --outdir=dist --format=cjs --sourcemap",
    "start": "node dist/server.js",
    "test": "jest",
    "clean:dist": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@packages/config": "workspace:*",
    "@packages/contracts": "workspace:*",
    "@packages/errors": "workspace:*",
    "@packages/http": "workspace:*",
    "@packages/observability": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "process": "^0.11.10",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
