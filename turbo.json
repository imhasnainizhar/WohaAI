{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.base.json",
        "turbo.json"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "build/**"
            ],
            "cache": true
        },
        "lint": {
            "outputs": [],
            "cache": true
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "package:dev": {
            "cache": true,
            "persistent": true
        },
        "package:build": {
            "dependsOn": [
                "^package:build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^typecheck"
            ]
        },
        "proto:generate": {
            "outputs": [
                "packages/proto/generated/**"
            ],
            "cache": true
        },
        "proto:watch": {
            "cache": false,
            "persistent": true
        },
        "proto:clean": {
            "cache": false
        }
    }
}