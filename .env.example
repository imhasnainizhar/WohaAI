###############################################
# 🌍 Common Environment Variables
# This file contains variables shared across all environments
# Local and Docker environments will extend/override these values
###############################################

# ============================================
# Global Configuration
# ============================================
NODE_ENV=development
DOCKER_TARGET=development
LOG_LEVEL=debug

# ============================================
# JWT Configuration
# ============================================

## Run this command each time to get secrets for the following fields:
## openssl rand -hex 32

JWT_ACCESS_SECRET_KEY="****"
JWT_REFRESH_SECRET_KEY="****"
JWT_PRIVATE_ACCESS_SECRET_KEY="****"
JWT_SIGNUP_SESSION_SECRET_KEY="****"

# ============================================
# Token Names
# ============================================
REFRESH_TOKEN_NAME=session__ref_tk
ACCESS_TOKEN_NAME=session__acc_tk
PRIVATE_ACCESS_TOKEN_NAME=session__priv_acc_tk
SIGNUP_SESSION_TOKEN_NAME=session__session_signup

# ============================================
# Database Configuration
# ============================================

## ⚠️ If not using Docker?? ⚠️
## ⚠️ Set it locally ⚠️
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_USER_DB=woahai_db
POSTGRES_PORT=5432
PRISMA_USER_DATABASE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_USER_DB}?schema=public

# ============================================
# Redis Configuration
# ============================================

## ⚠️ If not using Docker?? ⚠️
## ⚠️ Set it locally ⚠️
REDIS_CODE_C_URI=localhost
REDIS_CODE_C_PORT=6379
REDIS_PASSWORD_CODE_C=redis_password

# ============================================
# Mailer Configuration
# ============================================

## ChatGPT can help you here:
MAILER_HOST=smtp.email.com
MAILER_PORT=0000
MAILER_EMAIL_USER=your_email@email.com
MAILER_EMAIL_PASS=password
MAILER_EMAIL_FROM="WoahAI <your_email@email.com>"
MAIL_SECURE=false

# ============================================
# Service Ports
# ============================================
FRONTEND_APP_PORT=3000
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
AUTH_MAILER_SERVICE_PORT=8003
WOAH_NGINX_PROXY_PORT=8000

# ============================================
# Client & Cookie Configuration
# ============================================
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ============================================
# Kafka Configuration
# ============================================

## ⚠️ If not using Docker?? ⚠️
## ⚠️ Set it locally ⚠️
KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_PORT=9092
KAFKA_CLUSTERS_0_ZOOKEEPER_PORT=2181
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=localhost:9092
KAFKA_CLUSTERS_0_ZOOKEEPER=localhost:2181
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# ============================================
# CAPTCHA KEYS (Next.js + Backend)
# ============================================

## Get Keys by signin at Given URLS:
## https://admin.google.com
APP_PUBLIC_RECAPTCHA_SITE_KEY="****"
RECAPTCHA_SECRET_KEY="****"

# ============================================
# External API Keys
# ============================================

## Get Keys by signin at Given URLS:

## https://serper.dev
SERPER_API_KEY=****
