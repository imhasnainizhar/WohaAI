# ============================================
# Token Names
# ============================================
REFRESH_TOKEN_NAME=session__ref_tk
ACCESS_TOKEN_NAME=session__acc_tk
PRIVATE_ACCESS_TOKEN_NAME=session__priv_acc_tk
SIGNUP_SESSION_TOKEN_NAME=session__signup_tk
SIGNIN_SESSION_TOKEN_NAME=session__signin_tk

# ============================================
# Mailer Configuration
# ============================================

# You can create a new google account for this purpose, then set two-factor auth and add app password
# Google require two-factor auth and app password

MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER_EMAIL=****
MAILER_USER_PASSWORD="Replace with your app password(If required)"
MAILER_EMAIL_FROM="WoahAI woahai@woahai.com"
MAILER_SECURE=false

# ============================================
# External API Keys
# ============================================

## Set these keys to get in dev further

# Go here to get your Secret & Client Keys: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SECRET_KEY="****"

# Signin here: https://serper.dev/ to get your API Key
SERPER_API_KEY=****

# Go here: https://platform.openai.com/docs/overview
# and get your API key by signing in
OPENAI_API_KEY=****

## Auth Redis Cache Keys for signin and signup sessions
ACTIVE_SIGNIN_SESSION_CACHE_KEY=pending_signin
ACTIVE_SIGNUP_SESSION_CACHE_KEY=pending_signup


#####################################################
#----------------------------------------------------
# Configs Depending on Environment
#----------------------------------------------------
#####################################################

#----------------------------------------------------
## Local(dev) or Docker(dev) or Production
#----------------------------------------------------


# ============================================
# Frontend Ports
# ============================================
FRONTEND_APP_PORT=3000

# ============================================
# Service Ports
# ============================================
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
AUTH_MAILER_SERVICE_PORT=8003
WOAH_NGINX_PROXY_PORT=8000

# ============================================
# Docker Services Nmae Specifications
# ============================================
FRONTEND_CONTAINER_NAME=frontend-app

## For Dev(Local or Docker) only
## Setup Ngiinix and other services if running dev on local
NGINIX_PROXY_CONTAINER_NAME=nginix-dev

AUTH_SERVICE_CONTAINER_NAME=auth-service
USER_SERVICE_CONTAINER_NAME=user-service
AUTH_MAILER_CONTAINER_NAME=auth-mailer-service
# ============================================
# Client & Cookie Configuration
# ============================================
CLIENT_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ============================================
# Services URIs (Local by default)
# ============================================
APP_PUBLIC_GATEWAY_BASE_URI=http://localhost:${WOAH_NGINX_PROXY_PORT}

## Base URI to go to gateway(NGINIX on DEV, AWS Proxy on Production)
NEXT_PUBLIC_SERVICES_BASE_URI=http://localhost:${WOAH_NGINX_PROXY_PORT}

NEXT_PUBLIC_AUTH_API_URI=${NEXT_PUBLIC_BASE_URI}/api/auth
NEXT_PUBLIC_AUTH_MAILER_API_URI=${NEXT_PUBLIC_BASE_URI}/api/auth-mailer
NEXT_PUBLIC_USER_API_URI=${NEXT_PUBLIC_BASE_URI}/api/user

# ============================================
# Frontend Public Variables (Next.js)
# ============================================

# Go here to get your Secret & Client Keys: https://www.google.com/recaptcha/admin/create
APP_PUBLIC_RECAPTCHA_SITE_KEY=6LdyNyQsAAAAAF3CHcdxN9C8gxG6OYOEJikr5sPd

# ============================================
# MCP Server Ports
# ============================================
MCP_GATEWAY_PORT=9080
WEB_SEARCH_MCP_PORT=9092

# ============================================
# LLM Agent Port
# ============================================

WOAHAI_LLM_AGENT_PORT=9010



# ============================================
# USERS DATABASE
# ============================================

## Warning: Setup locally if not using Docker
USERS_POSTGRES_DB_USER=woahai_users
USERS_POSTGRES_DB_PASSWORD=my-password
USERS_POSTGRES_DB_NAME=woahai_user_db
USERS_POSTGRES_DB_HOST=user_postgres_db
USERS_POSTGRES_DB_INTERNAL_PORT=5432
USERS_POSTGRES_DB_EXTERNAL_PORT=5435

USERS_PRISMA_DB_URI=postgresql://${USERS_POSTGRES_DB_USER}:${USERS_POSTGRES_DB_PASSWORD}@${USERS_POSTGRES_DB_HOST}:${USERS_POSTGRES_DB_EXTERNAL_PORT}/${USERS_POSTGRES_DB_NAME}?schema=public

# ============================================
# THREADS DATABASE
# ============================================

## Warning: Setup locally if not using Docker
THREADS_POSTGRES_DB_USER=woahai_threads
THREADS_POSTGRES_DB_PASSWORD=my-password
THREADS_POSTGRES_DB_NAME=woahai_threads_db
THREADS_POSTGRES_DB_HOST=threads_postgres_db
THREADS_POSTGRES_DB_EXTERNAL_PORT=5439
THREADS_POSTGRES_DB_INTERNAL_PORT=5432

THREADS_PRISMA_DB_URI=postgresql://${THREADS_POSTGRES_DB_USER}:${THREADS_POSTGRES_DB_PASSWORD}@${THREADS_POSTGRES_DB_HOST}:${THREADS_POSTGRES_DB_INTERNAL_PORT}/${THREADS_POSTGRES_DB_NAME}?schema=public

#=============================================
# QDRANT Vector Store Config
#=============================================

## Warning: Setup locally if not using Docker
MEMORY_QDRANT_STORE_PORT=6060
MEMORY_QDRANT_STORE_URI=http://memory_qdrant_store:${MEMORY_QDRANT_STORE_PORT}/

#=============================================
# Redis Stores for Short term Memory rtrival
#=============================================

## Warning: Setup locally if not using Docker

## Note: Stuff like memories and chats are stored in qdrant and postgres but
## for quick retrival during live chat session, stored in Redis for efficiet response time.
## Memories and chats are stored in redis for ~30 minutes..
MEMORY_REDIS_STORE_HOST=memory_redis_store
MEMORY_REDIS_STORE_USERNAME=default
MEMORY_REDIS_STORE_PORT=6379
MEMORY_REDIS_STORE_PASSWORD=my-password
MEMORY_REDIS_STORE_URI=redis://:${MEMORY_REDIS_STORE_PASSWORD}@${MEMORY_REDIS_STORE_HOST}:${MEMORY_REDIS_STORE_PORT}

# ============================================
# Redis Configuration for Auth Verification
# ============================================
THREADS_REDIS_STORE_HOST=threads_redis_store
THREADS_REDIS_STORE_USERNAME=default
THREADS_REDIS_STORE_PORT=8010
THREADS_REDIS_STORE_PASSWORD=my-password
THREADS_REDIS_STORE_URI=redis://:${THREADS_REDIS_STORE_PASSWORD}@${THREADS_REDIS_STORE_HOST}:${THREADS_REDIS_STORE_PORT}

# ============================================
# Fluvio Configuration
# ============================================

## Warning: Setup locally if not using Docker

AUTH_FLUVIO_API_PORT=9003
AUTH_FLUVIO_API_HOST=localhost
AUTH_FLUVIO_API_URI=http://${AUTH_FLUVIO_API_HOST}:${AUTH_FLUVIO_API_PORT}/
AUTH_FLUVIO_CONTROL_PANE_PORT=localhost:2181
AUTH_FLUVIO_SC=${AUTH_FLUVIO_API_URI}

# ============================================
# Redis Configuration for Auth Verification
# ============================================
AUTH_REDIS_STORE_PORT=6379
AUTH_REDIS_STORE_HOST=auth_redis_store
AUTH_REDIS_STORE_PASSWORD=my-password
AUTH_REDIS_STORE_URI=redis://:${AUTH_REDIS_STORE_PASSWORD}@${AUTH_REDIS_STORE_HOST}:${AUTH_REDIS_STORE_PORT}
