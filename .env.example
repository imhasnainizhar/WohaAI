###############################################
# 🌍 Environment Configs & Variables
# This file contains variables by default for Docker
# .env.local overrides values for Local Dev (If local opted)
###############################################

## Dev Notice: Docker Environment is default and suggested for development process, things will be just commands way
## to setup, very playful experience than local setup. Local is also supported.


#####################################################
#----------------------------------------------------
# Configs NON-Depending on Environment
#----------------------------------------------------
#####################################################

# ============================================
# Global Configuration
# ============================================
NODE_ENV=development
DOCKER_TARGET=development
LOG_LEVEL=debug
FLV_LOG=debug

# ============================================
# JWT Configuration
# ============================================

## Default keys are given for development
## node command to generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'));"

JWT_ACCESS_SECRET_KEY="55d595783d4679fee055da8e4f7d41290ccbf1673438721783443d43452033f299d471770362c3fa00ed9b1ee747feec7843b154fed6a53a595d5bbd251f07e8"
JWT_REFRESH_SECRET_KEY="2dc02c91f0a1e06cb941edf7af3515f092b261b56db25443ae6afa0d14bad76830b7cdc4697315b2a4b6b19f3602ff2c97d8140a49620fbe8a17400cff8c3cf8"
JWT_PRIVATE_ACCESS_SECRET_KEY="c1decd057c74f763bb35bc3dedc45cc0e44749aebfd5ccf3cd5f92a3ea35b3491b4a67cedefaa244168503cf81dad240d5afc5376bd259e3fc92cc2d387b11ca"
JWT_SIGNUP_SESSION_SECRET_KEY="18e6b5de3fd23b183b867e57bbc8928e0e93ad1b8c6806c7664134d6eb03fa833f7075b39f82cf8823bddcf84007a3c2471172360269318152f2d528b3034113"
