# -------------------------------
# Base Dockerfile for Node Microservices
# -------------------------------
FROM node:20-alpine AS base

# Working directory
WORKDIR /src

# Copy package.json and lock file for caching
COPY package*.json ./

# Set environment variable for conditional installation
ARG NODE_ENV
ENV NODE_ENV=${NODE_ENV}

# Install dependencies conditionally:
# If dev, node_modules might be mounted, skip install
# If production, install fresh
# Only install dependencies if not mounted
RUN if [ "$NODE_ENV" = "production" ]; then \
      npm ci --only=production; \
    elif [ ! -d "node_modules" ]; then \
      npm install; \
    fi

# Expose default port
EXPOSE 3000

# Default command (can be overridden)
CMD ["npm", "run", "dev"]
