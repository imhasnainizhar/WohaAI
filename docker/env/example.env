###############################################
# 🌍 Global Configuration
# ---------------------------------------------
# Environment settings for Dockerized app stack
# Works for both Development & Production modes
###############################################

# Node environment mode: affects build optimizations
NODE_ENV=development

# Docker build target (defined in Dockerfile stages)
# Options: development | production
DOCKER_TARGET=development

###############################################
# ⚛️ Frontend (Next.js) Configuration
# ---------------------------------------------
# Frontend App will use NEXT_PUBLIC_ variables at runtime
###############################################

# Next.js frontend exposed port
FRONTEND_APP_PORT=3000

# Base URL for API Gateway (used by frontend)
APP_PUBLIC_GATEWAY_BASE_URL_01=http://localhost:8000

# Google reCAPTCHA public key
 
APP_PUBLIC_RECAPTCHA_SITE_KEY=6Lc_-WErAAAAAMFDE86OJbV9Kwd6lEfjVg-EmJJh

###############################################
# 🚪 API Gateway Configuration
# ---------------------------------------------
# The API gateway routes traffic to microservices
###############################################

API_GATEWAY=8000

###############################################
# 🧩 Microservices Configuration
# ---------------------------------------------
# Each microservice listens on its own port
###############################################

SIGNIN_SERVICE_PORT=8001
SIGNOUT_SERVICE_PORT=8002
SIGNUP_SERVICE_PORT=8003
USER_VERIFY_CODE_PORT=8004
CAPTCHA_PORT=8005
CODE_MAILER_PORT=8006
SIGNUP_VALIDATOR_PORT=8007
USER_SERVICE_PORT=8008

###############################################
# 🗄️ Database Configuration
# ---------------------------------------------
# PostgreSQL connection string for Prisma ORM
###############################################

DATABASE_PROVIDER=postgresql
PRISMA_DATABASE_URL=postgresql://postgres:MyUser1234@postgres:5432/user_db?schema=public

###############################################
# 🔐 Authentication / Security
# ---------------------------------------------
# JWT_SECRET must be unique and secure per environment
###############################################

JWT_SECRET=650b2f5fdded23f2e796ce03b8c4509dd15104932f7514fa0b480890f362add7

###############################################
# 🧠 Redis Configuration
# ---------------------------------------------
# Used for verification codes, caching, and sessions
###############################################

# Redis password and port
REDIS_PASSWORD_CODE_C=redis_code_c123
REDIS_SERVER_PORT_01=6379

# Redis connection URI (auto-injected with env vars)
REDIS_CODE_C=redis://default:${REDIS_PASSWORD_CODE_C}@redis_code_c:${REDIS_SERVER_PORT_01}

