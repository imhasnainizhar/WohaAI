###############################################
# 🐳 Docker Environment Variables
# This file extends .env with Docker-specific configurations
# Used when running services in Docker containers
###############################################

# ============================================
# Docker Configs
# ============================================
# These values override .env for Docker container networking

## 🚨 WARNING: These Ports Must be Similar to .env file ports 🚨
FRONTEND_APP_PORT=3000
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
AUTH_MAILER_SERVICE_PORT=8003
WOAH_NGINX_PROXY_PORT=8000

# ============================================
# Client Origin (Docker)
# ============================================
CLIENT_ORIGIN=http://frontend:${FRONTEND_APP_PORT}
COOKIE_DOMAIN=localhost

# ============================================
# Frontend URLs (Docker - accessible from host)
# ============================================
APP_PUBLIC_GATEWAY_BASE_URI_01=http://nginx-proxy:${WOAH_NGINX_PROXY_PORT}
NEXT_PUBLIC_BASE_URI=http://frontend:${FRONTEND_APP_PORT}
NEXT_PUBLIC_AUTH_API_URI=http://auth-service:${AUTH_SERVICE_PORT}/api/auth
NEXT_PUBLIC_AUTH_MAILER_API_URI=http://auth-mailer-service:${AUTH_MAILER_SERVICE_PORT}/api/auth-mailer
NEXT_PUBLIC_USER_API_URI=http://user-service:${USER_SERVICE_PORT}/api/user

#=============================================
# QDRANT Vector Store Config
#=============================================
AGENT_MEMORY_STORE_PORT=6060
AGENT_AGENT_MEMORY_STORE_URI=http://agent_memory_store:${AGENT_MEMORY_STORE_PORT}/