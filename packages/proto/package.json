{
  "name": "@wohaai/proto",
  "version": "1.0.0",
  "description": "Proto files and generated TypeScript types for gRPC services",
  "scripts": {
    "generate": "pnpm generate:user",
    "generate:user": "node -e \"require('fs').mkdirSync('./generated', { recursive: true })\" && protoc --ts_proto_out=./generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,forceLong=long,useOptionals=messages,outputBinaryMethods=false -I./services ./services/user/user.proto",
    "watch": "chokidar \"./services/**/*.proto\" -c \"pnpm generate\"",
    "clean": "rimraf generated"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^0.1.1",
    "@grpc/grpc-js": "^1.10.0",
    "long": "^5.2.3"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "protobufjs": "^8.6.4",
    "rimraf": "^6.1.3",
    "ts-proto": "^2.11.8"
  }
}