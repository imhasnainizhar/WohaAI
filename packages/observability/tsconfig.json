{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "composite": true,
        "incremental": true,
        "declaration": true,
        "declarationMap": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",            /* Project Structure */
        "rootDir": "src",
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUncheckedIndexedAccess": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "src",
    ],
    "exclude": [
        "node_modules",
        "dist",
    ]
}