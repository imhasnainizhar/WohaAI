{
    "compilerOptions": {
        "composite": true,
        "declaration": true,
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowSyntheticDefaultImports": true,
        /* Project Structure */
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@shared/*": [
                "./*"
            ]
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}