{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "node16",
        "allowSyntheticDefaultImports": true,
        /* Project Structure */
        "outDir": "./dist",
        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        /* Module + Imports */
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Path Aliases (modern way, no baseUrl needed) */
        "paths": {
            "@common/*": [
                "./common/*"
            ],
            "@middleware/*": [
                "./middleware/*"
            ],
            "@auth/*": [
                "./auth/*"
            ],
            "@utils/*": [
                "./utils/*"
            ],
            "@errors/*": [
                "./errors/*"
            ],
            "lib/*": [
                "./lib/*"
            ],
            "@regex/*": [
                "./regex/*"
            ],
        },
        /* Output + Debugging */
        "sourceMap": true
    },
    "include": [
        "utils/**/*.ts",
        "zod/schemas/**/*.ts",
        "errors/**/*.ts",
        "lib/**/*.ts",
        "auth/domain/**/*.ts", "auth/cookie.ts",
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}