generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
}

// Optional: To enable ESM output, use the previewFeatures flag
// previewFeatures = ["clientExtensions"]
// Ignore this error, everything is working, this is just prisma bug I think.
datasource db {
  provider = "postgresql"
}

enum SessionDuration {
  temporary
  persistent
}

model User {
  userID         String   @id @default(uuid())
  profilePicURI  String?
  firstName  String
  lastName   String
  email          String   @unique
  username       String   @unique
  dateOfBirth    DateTime?

  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorEnabledAt   DateTime?

  backupCodes          TwoFactorBackupCode[]

  // Foreign Relations
  userSession UserSession[]
  cards       Card[]
}

model TwoFactorBackupCode {
  backupCodeID String @id @default(uuid())
  userID       String

  codeHash     String
  used         Boolean @default(false)

  user User @relation(fields: [userID], references: [userID])

  @@index([userID])
}

model Card {
  cardId String @id @default(uuid())

  // Foreign Relations
  userID String
  user   User   @relation(fields: [userID], references: [userID])
}

model UserSession {
  userSessionID     String    @id @default(uuid())
  refreshTokenHash  String
  createdAt         DateTime  @default(now())
  revoked           Boolean   @default(false)
  revokedAt         DateTime?
  rememberMe        Boolean   @default(false)
  userIPAddress     String
  userDeviceName    String
  userDeviceType    String
  userDeviceBrowser String
  userDeviceOS      String
  sessionDuration   SessionDuration

  userID String
  user   User   @relation(fields: [userID], references: [userID])
}
