{
    "name": "@wohaai/types",
    "version": "1.0.0",
    "description": "Types package for woha ai",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "ai",
        "agents",
        "typescript",
        "openai",
        "models"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/imhasnainizhar/WohaAI.git"
    },
    "license": "MIT",
    "author": "Hasnain Izhar",
    "scripts": {
        "package:dev": "tsc -b -w && cpy \"src/**/*.d.ts\" dist",
        "package:build": "tsc -b && cpy \"src/**/*.d.ts\" dist"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "devDependencies": {
        "cpy-cli": "^7.0.0",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    }
}