generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
}

// Optional: To enable ESM output, use the previewFeatures flag
// previewFeatures = ["clientExtensions"]
// Ignore this error, everything is working, this is just prisma bug I think.
datasource db {
  provider = "postgresql"
}

model User {
  userID         String   @id @default(uuid())
  profilePicURI  String?
  userFirstName  String
  userLastName   String
  email          String   @unique
  username       String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  // Foreign Relations
  userSession UserSession[]
  cards       Card[]
}

model Card {
  cardId String @id @default(uuid())

  // Foreign Relations
  userID String
  user   User   @relation(fields: [userID], references: [userID])
}

model UserSession {
  userSessionID     String    @id @default(uuid())
  refreshTokenHash  String
  createdAt         DateTime  @default(now())
  revoked           Boolean   @default(false)
  revokedAt         DateTime?
  rememberMe        Boolean   @default(false)
  userIPAddress     String
  userDeviceID      String
  userDeviceName    String
  userDeviceType    String
  userDeviceBrowser String
  userDeviceOS      String

  userID String
  user   User   @relation(fields: [userID], references: [userID])
}
