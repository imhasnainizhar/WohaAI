{
  "name": "@wohaai/db",
  "version": "1.0.0",
  "description": "Package for WohaAI DB",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "openai",
    "models"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imhasnainizhar/WohaAI.git"
  },
  "license": "MIT",
  "author": "Hasnain Izhar",
  "scripts": {
    "package:dev": "tsc -b -w",
    "package:build": "tsc -b",
    "build:types": "tsc --emitDeclarationOnly"
  },
  "exports": {
    "./connection": {
      "import": "./dist/connection/index.js",
      "require": "./dist/connection/index.js",
      "types": "./dist/connection/index.d.ts"
    },
    "./models": {
      "import": "./dist/models/index.js",
      "require": "./dist/models/index.js",
      "types": "./dist/models/index.d.ts"
    }
  },
  "dependencies": {
    "@wohaai/telemetry": "workspace:*",
    "@wohaai/constants": "workspace:*",
    "@wohaai/types": "workspace:*",
    "mongoose": "^9.6.3"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}