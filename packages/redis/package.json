{
  "name": "@wohaai/redis",
  "version": "1.0.0",
  "description": "Redis reusable package for this monorepo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "openai",
    "models"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/imhasnainizhar/WohaAI.git"
  },
  "license": "MIT",
  "author": "Hasnain Izhar",
  "scripts": {
    "package:dev": "tsc -b -w",
    "package:build": "tsc -b",
    "clean": "rimraf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@wohaai/errors": "workspace:*",
    "@wohaai/telemetry": "workspace:*",
    "ioredis": "^5.11.0"
  },
  "devDependencies": {
    "@types/redis": "^4.0.11",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
